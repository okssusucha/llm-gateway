# Gateway-issued client API keys (comma-separated). Clients send one as
# `Authorization: Bearer <key>`.
GATEWAY_API_KEYS=demo-key

# Default provider when a model has no explicit route. "echo" keeps the gateway
# fully functional offline with deterministic responses.
GATEWAY_DEFAULT_PROVIDER=echo

# Real provider credentials. Leave unset to run offline on the echo provider.
# GATEWAY_OPENAI_API_KEY=sk-...
# GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
# GATEWAY_ANTHROPIC_API_KEY=sk-ant-...
# GATEWAY_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Per-key token-bucket rate limiting.
GATEWAY_RATE_LIMIT_CAPACITY=60
GATEWAY_RATE_LIMIT_REFILL_PER_SEC=1.0

# Response caching. Set GATEWAY_REDIS_URL to use Redis instead of the in-memory cache.
GATEWAY_CACHE_ENABLED=true
GATEWAY_CACHE_TTL_SECONDS=300
# GATEWAY_REDIS_URL=redis://redis:6379/0
